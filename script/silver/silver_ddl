INSERT INTO silver.stg_sales
(
    sls_ord_id,
    sls_prd_key,
    sls_cust_id,
    sls_order_dt,
    sls_ship_dt,
    sls_due_dt,
    sls_sales,
    sls_quantity,    -- Adding these to ensure your SELECT pairs 
    sls_price   -- perfectly with your target table columns
)
SELECT 
    NULLIF(TRIM(sls_ord_id), '') AS sls_ord_num,
    NULLIF(TRIM(sls_prd_key), '') AS sls_prd_key,
    NULLIF(TRIM(sls_cust_id), '')::INT AS sls_cust_id,
    
    -- 1. Transform Order Date (Handling 0 or malformed 8-digit strings)
    CASE 
        WHEN NULLIF(TRIM(sls_order_dt), '') IS NULL OR NULLIF(TRIM(sls_order_dt), '') = '0' OR LENGTH(TRIM(sls_order_dt)) != 8 THEN NULL
        ELSE TO_DATE(TRIM(sls_order_dt), 'YYYYMMDD')
    END AS sls_order_dt,
    
    -- 2. Transform Shipping Date
    CASE 
        WHEN NULLIF(TRIM(sls_ship_dt), '') IS NULL OR NULLIF(TRIM(sls_ship_dt), '') = '0' OR LENGTH(TRIM(sls_ship_dt)) != 8 THEN NULL
        ELSE TO_DATE(TRIM(sls_ship_dt), 'YYYYMMDD')
    END AS sls_ship_dt,
    
    -- 3. Transform Due Date
    CASE 
        WHEN NULLIF(TRIM(sls_due_dt), '') IS NULL OR NULLIF(TRIM(sls_due_dt), '') = '0' OR LENGTH(TRIM(sls_due_dt)) != 8 THEN NULL
        ELSE TO_DATE(TRIM(sls_due_dt), 'YYYYMMDD')
    END AS sls_due_dt,
    
    -- 4. Clean and Recalculate Sales if bad/null (Sales = Qty * |Price|)
    CASE 
        WHEN NULLIF(TRIM(sls_sales), '') IS NULL 
             OR NULLIF(TRIM(sls_sales), '')::NUMERIC <= 0 
             OR NULLIF(TRIM(sls_sales), '')::NUMERIC != (NULLIF(TRIM(sls_qty), '')::INT * ABS(NULLIF(TRIM(sls_price), '')::NUMERIC))
        THEN (NULLIF(TRIM(sls_quantity), '')::INT * ABS(NULLIF(TRIM(sls_price), '')::NUMERIC))
        ELSE NULLIF(TRIM(sls_sales), '')::NUMERIC
    END AS sls_sales,
    
    -- 5. Include raw baseline elements for target structure consistency
    COALESCE(NULLIF(TRIM(sls_qty), '')::INT, 0) AS sls_qty,
    COALESCE(NULLIF(TRIM(sls_price), '')::NUMERIC, 0.0) AS sls_price

FROM bronze.stg_sales;

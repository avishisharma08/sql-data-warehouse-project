ROP TABLE IF EXISTS silver.erp_cust_az12;

CREATE TABLE silver.erp_cust_az12 (
    cid   VARCHAR(50),
    bdate DATE,
    gen   VARCHAR(20)
);
INSERT INTO silver.erp_cust_az12 (cid, bdate, gen)
SELECT 
    -- 1. Strip 'NAS' prefix if it exists at the start of the customer ID
    CASE 
        WHEN TRIM(cid) LIKE 'NAS%' THEN SUBSTRING(TRIM(cid) FROM 4)
        ELSE NULLIF(TRIM(cid), '')
    END AS cid,
    
    -- 2. Handle Birthdates (If the birthdate is in the future, set it to NULL)
    CASE 
        WHEN bdate::DATE > CURRENT_DATE THEN NULL
        ELSE bdate::DATE
    END AS bdate,
    
    -- 3. Standardize Genders into clean lookups
    CASE 
        WHEN UPPER(TRIM(gen)) IN ('F', 'FEMALE') THEN 'Female'
        WHEN UPPER(TRIM(gen)) IN ('M', 'MALE')   THEN 'Male'
        ELSE 'n/a'
    END AS gen

FROM bronze.erp_cust_az12; -- Double check if your bronze table has a prefix or is just erp_cust_az12
DROP TABLE IF EXISTS silver.erp_loc_a101;

CREATE TABLE silver.erp_loc_a101 (
    cid   VARCHAR(50),
    cntry VARCHAR(100)
);
INSERT INTO silver.erp_loc_a101 (cid, cntry)
SELECT 
    -- 1. Remove hyphens completely from the customer ID string
    REPLACE(TRIM(cid), '-', '') AS cid,
    
    -- 2. Standardize abbreviation codes into clean full names
    CASE 
        WHEN TRIM(cntry) = 'DE' THEN 'Germany'
        WHEN TRIM(cntry) IN ('US', 'USA') THEN 'United States'
        WHEN NULLIF(TRIM(cntry), '') IS NULL THEN 'n/a'
        ELSE TRIM(cntry)
    END AS cntry

FROM bronze.erp_loc_a101;

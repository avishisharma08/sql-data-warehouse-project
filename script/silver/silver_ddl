TRUNCATE TABLE silver.stg_producer;

INSERT INTO silver.stg_producer
(
    prd_id,
    prd_key,
    prd_name,
    prd_cost,
    prd_line,
    prd_start_dt,
    prd_end_dt
)
SELECT 
    NULLIF(TRIM(prd_id), '')::INT AS prd_id,
    
    -- Cleaning prd_key using substring just like your screenshot
    SUBSTRING(TRIM(prd_key), 7, LENGTH(TRIM(prd_key))) AS prd_key,
    
    TRIM(prd_name) AS prd_name,
    
    -- Coalescing cost safely
    COALESCE(NULLIF(TRIM(prd_cost), '')::NUMERIC, 0.0) AS prd_cost,
    
    -- Mapping the product line
    CASE UPPER(TRIM(prd_line))
        WHEN 'M' THEN 'Mountain'
        WHEN 'R' THEN 'River'
        WHEN 'S' THEN 'Other'
        WHEN 'T' THEN 'Tourist'
        ELSE 'N/A'
    END AS prd_line,
    
    NULLIF(TRIM(prd_start_dt), '')::DATE AS prd_start_dt,
    
    -- Calculating the proper end date with the fixed comma separation
    (LEAD(NULLIF(TRIM(prd_start_dt), '')::DATE) OVER (
        PARTITION BY TRIM(prd_key) 
        ORDER BY NULLIF(TRIM(prd_start_dt), '')::DATE
    ) - INTERVAL '1 day')::DATE AS prd_end_dt

FROM bronze.stg_producer;
